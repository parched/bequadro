<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="FsCheck.Xunit.v3" />
    <!-- In-memory compilations of generated code need a compiler that understands C# unions (C# 15) -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.12.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bequadro.Generator\Bequadro.Generator.csproj" />
    <ProjectReference Include="..\..\src\Bequadro\Bequadro.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Snapshots are expected generator output, not part of the test assembly -->
    <Compile Remove="Snapshots/**" />
    <None Include="Snapshots/**" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AwesomeAssertions" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>

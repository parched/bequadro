<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: Missing XML comment for publicly visible type or member -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisMode>All</AnalysisMode>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>

    <!--
      CON-007: a release's version comes only from its tag. build.py sets BEQUADRO_VERSION from the release tag, and every
      other build is 0.0.0-unreleased, which sorts below any release.
    -->
    <Version>0.0.0-unreleased</Version>
    <Version Condition="'$(BEQUADRO_VERSION)' != ''">$(BEQUADRO_VERSION)</Version>
  </PropertyGroup>

  <!-- CON-007: CI builds map source paths to the repository, so published packages are reproducible -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
